{
  "$schema": "http://json.schemastore.org/template",
  "author": "Werter",
  "classifications": [ "Web", "Web API", "API" ],
  "identity": "Werter.ModularApis.WebApi",
  "name": "Werter Modular APIs",
  "shortName": "werter-modular-apis",
  "sourceName": "Werter.ModularApis",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": "Target net10.0"
        }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    },
    "FeatureName": {
      "type": "parameter",
      "datatype": "text",
      "displayName": "Feature name (plural)",
      "description": "Nome plural da feature de exemplo em PascalCase (pasta, namespace, tags). Ex.: Todos, Products, Pedidos",
      "defaultValue": "Todos",
      "replaces": "Todos",
      "fileRename": "Todos"
    },
    "featureNameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "FeatureName",
        "toLower": true
      },
      "replaces": "todos",
      "fileRename": "todos"
    },
    "EntityName": {
      "type": "parameter",
      "datatype": "text",
      "displayName": "Entity name (singular)",
      "description": "Nome singular da entidade em PascalCase (classes, Bruno). Ex.: Todo, Product, Pedido",
      "defaultValue": "Todo",
      "replaces": "Todo",
      "fileRename": "Todo"
    },
    "entityNameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "EntityName",
        "toLower": true
      },
      "replaces": "todo",
      "fileRename": "todo"
    }
  }
}
